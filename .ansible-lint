---
# Exclude directories or files from linting
exclude_paths:
  - .git/
  - venv/
  - node_modules/
  - collections/
  - "*/vault.yml"
  - host_vars/localhost/vault.yml
  - host_files/localhost/nvim/autoload/plugged/
  - host_files/localhost/nvim/pack/github/start/copilot.vim/
  # Vendored agent skills. Third-party YAML that happens to live in this repo,
  # not Ansible content, and not ours to reformat.
  - host_files/localhost/ai/skills/

# Nothing is skipped.
#
# This list used to hold '204' and '306' — numeric rule ids from ansible-lint 4,
# which version 26 does not recognise, so they suppressed nothing while implying
# decisions that were never in force. 'internal-error' and 'var-spacing' are not
# rule names either. Removing them changed no output, which is the proof they
# were dead. If a rule genuinely needs skipping, name it and say why here.
skip_list: []

use_default_rules: true
verbosity: 1

# Special environment variables for ansible-lint to work with vaults
# (these need to be set in the environment, not here)
# ANSIBLE_VAULT_PASSWORD_FILE: /dev/null
# ANSIBLE_VAULT_ID_MATCH: False
