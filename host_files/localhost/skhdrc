# Managed by Ansible.
#
# Bare F-key presses open specific apps. This only works because
# com.apple.keyboard.fnState is set to true (see roles/macos/defaults/main.yml),
# which makes F1-F12 standard function keys by default and moves volume /
# brightness / etc. onto Fn+F-key instead of the factory-default other way
# round. Without that setting, a bare F1 press never reaches skhd as a key
# event — the OS consumes it as a media key first.
#
# `open -b <bundle-id>` is used instead of `open -a "App Name"`, since bundle
# IDs do not change if an app gets renamed or moved and cannot be typo'd against
# a display name containing spaces or parentheses.

f1  : open -b "com.cmuxterm.app"              # cmux
f2  : open -b "com.t3tools.t3code"            # T3 Code (Alpha)
f3  : open -b "com.microsoft.edgemac"         # Microsoft Edge
f4  : open -b "org.mozilla.firefox"           # Firefox
f5  : open -b "com.tinyspeck.slackmacgap"     # Slack
f6  : open -b "md.obsidian"                   # Obsidian
f7  : open -b "com.linear"                    # Linear
f8  : open -b "com.apple.Music"               # Apple Music
f9  : open -b "com.openai.codex"              # ChatGPT
f10 : open -b "com.anthropic.claudefordesktop" # Claude (desktop app)

# Switch appearance manually. Turn Auto off first so scheduled appearance
# changes cannot undo the selected mode later.
f11 : defaults write -g AppleInterfaceStyleSwitchesAutomatically -bool false; osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to not dark mode'

# Runs a native shortcut named "Toggle Focus". Keep Focus behavior in Shortcuts
# rather than driving Control Center UI through brittle accessibility scripting.
f12 : /usr/bin/shortcuts run "Toggle Focus"
