# Managed by Ansible.
# Follow macOS appearance with matching built-in Nord themes. cmux embeds the
# Ghostty theme collection, so its terminal surfaces use this setting too.
theme = light:Nord Light,dark:Nord

# Treat the left Option key as Alt so shell/editor Meta shortcuts work
# consistently while keeping the right Option key available for macOS
# special-character input.
macos-option-as-alt = left
