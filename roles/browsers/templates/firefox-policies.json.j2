{% macro nodes(records, prefix, root=false) -%}
[{% set state = namespace(first=true, folders=[]) %}
{% if root %}{"toplevel_name": {{ browsers_firefox_bookmarks_catalog.managed_folder | to_json(ensure_ascii=False) }}}{% set state.first = false %}{% endif %}
{% for bookmark in records if bookmark.folder == prefix %}
{% if not state.first %},{% endif %}{"name": {{ bookmark.title | to_json(ensure_ascii=False) }}, "url": {{ bookmark.url | to_json(ensure_ascii=False) }}}{% set state.first = false %}
{% endfor %}
{% set depth = prefix | length %}
{% for bookmark in records %}
{% if bookmark.folder | length > depth and bookmark.folder[:depth] == prefix %}
{% set child = bookmark.folder[depth] %}{% if child not in state.folders %}{% set _ = state.folders.append(child) %}{% endif %}
{% endif %}
{% endfor %}
{% for folder in state.folders | sort %}
{% if not state.first %},{% endif %}{"name": {{ folder | to_json(ensure_ascii=False) }}, "children": {{ nodes(records, prefix + [folder]) }}}{% set state.first = false %}
{% endfor %}
]
{%- endmacro %}
{
  "policies": {
{% for policy in browsers_firefox_policies_catalog.policies if policy.scope == 'mandatory' %}
    {{ policy.name | to_json(ensure_ascii=False) }}: {{ policy.value | to_json(ensure_ascii=False) }},
{% endfor %}
    "ManagedBookmarks": {{ nodes(browsers_firefox_bookmarks_catalog.bookmarks, [], true) }},
    "ExtensionSettings": {
      "*": {"installation_mode": "allowed"}{% for extension in browsers_firefox_extensions_catalog.required %},
      {{ extension.id | to_json(ensure_ascii=False) }}: {
        "installation_mode": "force_installed",
        "install_url": {{ extension.update_url | to_json(ensure_ascii=False) }}
      }{% endfor %}
    }
  }
}
