{# Extensions and mandatory policies only. Bookmarks are recorded in the
   catalog, never pushed back as ManagedBookmarks — see roles/browsers/README.md. #}
{
  "policies": {
{% for policy in browsers_firefox_policies_catalog.policies if policy.scope == 'mandatory' %}
    {{ policy.name | to_json(ensure_ascii=False) }}: {{ policy.value | to_json(ensure_ascii=False) }},
{% endfor %}
    "ExtensionSettings": {
      "*": {"installation_mode": "allowed"}{% for extension in browsers_firefox_extensions_catalog.required %},
      {{ extension.id | to_json(ensure_ascii=False) }}: {
        "installation_mode": "force_installed",
        "install_url": {{ extension.update_url | to_json(ensure_ascii=False) }}
      }{% endfor %}
    }
  }
}
