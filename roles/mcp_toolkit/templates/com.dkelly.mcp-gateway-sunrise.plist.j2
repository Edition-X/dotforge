<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dkelly.mcp-gateway-{{ mcp_toolkit_profile }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ user_dir }}/.config/mcp-gateway/{{ mcp_toolkit_profile }}/run.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>{{ user_dir }}/Library/Logs/mcp-gateway-{{ mcp_toolkit_profile }}.log</string>
  <key>StandardErrorPath</key>
  <string>{{ user_dir }}/Library/Logs/mcp-gateway-{{ mcp_toolkit_profile }}.log</string>
</dict>
</plist>
