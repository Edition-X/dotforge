{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{ ai_routing_models.harnesses.opencode.model_prefix }}{{ ai_routing_models.tiers.lead.openai.model }}",
  "small_model": "{{ ai_routing_models.harnesses.opencode.model_prefix }}{{ ai_routing_models.tiers.utility.openai.model }}",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "snapshot": true,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 12
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 20000
  },
  "lsp": {
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "ansible": {
      "command": ["ansible-language-server", "--stdio"],
      "extensions": [".yml", ".yaml"]
    },
    "yaml-ls": { "disabled": true }
  },
  "mcp": {
    "arcane": {
      "type": "local",
      "command": ["{{ user_dir }}/.local/bin/arcane", "mcp"],
      "enabled": true
    },
    "1password": {
      "type": "local",
      "command": ["{{ ai_onepassword_mcp_bin }}"],
      "enabled": true
    },
    "mcp-sunrise": {
      "type": "remote",
      "url": "{{ mcp_gateway_url }}",
      "headers": { "Authorization": "Bearer {{ mcp_gateway_sunrise_token }}" },
      "oauth": false,
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "command *": "allow",
      "true *": "allow",
      "devcontainer *": "allow",
      "git worktree *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git check-ignore*": "allow",
      "git ls-tree *": "allow",
      "make validate-opencode*": "allow",
      "make test-ai-agents*": "allow",
      "make lint*": "allow",
      "make ci*": "allow",
      "pytest*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "pnpm test*": "allow",
      "yarn test*": "allow",
      "go test*": "allow",
      "cargo test*": "allow",
      "git push*": "allow",
      "printf *": "allow",
      "ansible-playbook *": "allow",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout --*": "deny",
      "rm -rf*": "deny",
      "gh pr merge*": "deny",
      "terraform destroy*": "deny",
      "kubectl delete*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/Projects/**": "allow"
    },
    "linear_*": "allow"
  }
}
