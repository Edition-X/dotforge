{# Renders one native OpenCode agent from the canonical, provider-neutral
   routing policy (host_files/localhost/ai/routing/). `item` comes from
   opencode_agents in group_vars/macbooks.yml and carries only name/file/
   role/mode/description — model, variant, steps, dispatch rights and prompt
   all resolve from ai_routing_models / ai_routing_workflow so nothing here
   is hardcoded per agent. #}
{% set role = ai_routing_workflow.roles[item.role] %}
{% set tier = ai_routing_models.tiers[role.tier] %}
---
description: {{ item.description }}
mode: {{ item.mode }}
model: {{ ai_routing_models.harnesses.opencode.model_prefix }}{{ tier.openai.model }}
variant: {{ tier.openai.effort }}
steps: {{ role.limits.opencode_steps }}
permission:
  task:
    "*": deny
{% for dispatched in role.may_dispatch %}
    {{ dispatched }}: allow
{% endfor %}
{% if role.read_only %}
  edit: deny
{% elif item.role == 'orchestrator' %}
  edit:
    "*": deny
    "docs/**": allow
{% elif item.role == 'documentation' %}
  edit:
    "*": deny
    "*.md": allow
    "**/*.md": allow
    "README*": allow
    "docs/**": allow
{% else %}
  edit: allow
{% endif %}
  external_directory:
    "*": ask
    "~/Projects/**": allow
{% if role.read_only %}
  notion_*: deny
  grafana_*: deny
{% endif %}
{% if item.role != 'documentation' %}
  linear_*: deny
{% else %}
  linear_*: allow
{% endif %}
---
{{ (lookup('file', ai_source_dir ~ '/skills/execute-playbook/SKILL.md')) | regex_replace('(?s)^---.*?---\n', '') | trim }}

---

{{ lookup('file', ai_source_dir ~ '/routing/' ~ role.prompt) | trim }}
