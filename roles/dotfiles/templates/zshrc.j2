plugins=(virtualenv)

HISTFILE=~/.histfile
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory autocd beep nomatch notify autopushd
unsetopt extendedglob
unsetopt HIST_VERIFY

source /opt/homebrew/share/antigen/antigen.zsh
antigen use oh-my-zsh
antigen bundle zsh-users/zsh-autosuggestions
antigen bundle zsh-users/zsh-syntax-highlighting
antigen bundle common-aliases
antigen bundle zsh_reload
#antigen bundle z
#antigen bundle andrewferrier/fzf-z

antigen apply

# Prompt. Must come after `antigen apply` so nothing installed above can
# overwrite PROMPT. Configured by ~/.config/starship.toml.
eval "$(starship init zsh)"

# Ensure Home/End and word-wise navigation work consistently across
# terminal emulators and through tmux.
bindkey $'\e[H' beginning-of-line
bindkey $'\e[F' end-of-line
bindkey $'\eOH' beginning-of-line
bindkey $'\eOF' end-of-line
bindkey $'\e[1~' beginning-of-line
bindkey $'\e[4~' end-of-line
bindkey $'\e[7~' beginning-of-line
bindkey $'\e[8~' end-of-line
bindkey $'\eb' backward-word
bindkey $'\ef' forward-word
bindkey $'\e[1;3D' backward-word
bindkey $'\e[1;3C' forward-word


eval "$(/opt/homebrew/bin/brew shellenv)"

# Auto-start/attach tmux for interactive shells, EXCEPT under cmux.
#
# cmux is its own multiplexer: it drives tmux in control mode and manages its
# own tabs/panes. If every cmux shell runs `tmux a` it attaches all tabs to the
# same session, so they all mirror each other. cmux sets CMUX_SHELL_INTEGRATION_DIR
# in the shell env (via its ZDOTDIR bootstrap, before this file is sourced), so
# we use that to opt cmux out. Ghostty and other terminals keep tmux as before.
if [ -z "$TMUX" ] && [ -z "$CMUX_SHELL_INTEGRATION_DIR" ]; then
  TMUX_OUTPUT="$(tmux a 2>&1)"
  if [[ "$TMUX_OUTPUT" == *"no sessions"* ]]; then
      tmux new -s "SunRise Robotics" -n "Reactive"
  else
      tmux a
  fi
fi

export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init --path)"

source ~/.aliases
source ~/.env_vars
[ -f ~/.env_secrets ] && source ~/.env_secrets
source ~/.functions
