# {{ ansible_managed }}
# Non-secret environment variables. Secrets live in ~/.env_secrets.
export TERM=xterm-256color
export EDITOR=nvim
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"
export AWS_PAGER=""
export VAULT_PASSWORD={{ project_dir }}/credentials.txt
export ANSIBLE_VAULT_PASSWORD_FILE=$VAULT_PASSWORD
export PYRIGHTCONFIG={{ config_paths.pyright_config }}
