---
extends: relaxed

ignore: |
  collections/
  .git/
  venv/
  node_modules/
  host_files/localhost/nvim/autoload/plugged/
  host_files/localhost/nvim/pack/github/start/copilot.vim/

# ansible-lint applies its own yamllint rules on top of this file and refuses
# to use a config that conflicts with them — it warned on every run and
# disabled its fix mode. These three now match what it requires.
rules:
  line-length:
    max: 120
    level: warning
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
  comments:
    min-spaces-from-content: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  comments-indentation: disable  # don't force comment indentation
